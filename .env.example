# Copy to .env — scripts/setup.sh does this and generates the password.

# Hostname pointing at this server (an A record to the VPS IP), e.g.
# ai.example.com. Caddy gets the HTTPS certificate for it automatically.
# :80 serves plain HTTP for a first test without a domain — not for real use.
DOMAIN=ai.example.com

# Database password, generated by setup.sh. Back up .env: without it the
# database backups cannot be restored into a new server easily.
POSTGRES_PASSWORD=

# ── Models ───────────────────────────────────────────────────────────────────
# Downloaded by scripts/pull-models.sh. Check the license of each before using
# it in a paid product, and record it in MODELS.md.
MODELS="qwen3:8b"
# The model every agent uses...
DEFAULT_MODEL=qwen3:8b
# ...unless named here, as agent=model pairs, e.g.
# MODEL_OVERRIDES=vndor.product-description=qwen3:4b
MODEL_OVERRIDES=

# ── Capacity (defaults fit an 8 vCPU / 24 GB CPU server) ─────────────────────
# Memory the model runtime may use. Leave 6-8 GB for the OS, Postgres and API.
OLLAMA_MEMORY_LIMIT=16g
# Context window per call: longer transcripts need more, and it costs RAM.
NUM_CTX=12288
MAX_TRANSCRIPT_CHARS=20000
# Model calls at once. 1 on CPU; raise on a GPU with memory to spare.
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
# How long a request waits for its turn before a 503 + Retry-After.
QUEUE_TIMEOUT_SECONDS=120
DEFAULT_RATE_LIMIT_PER_MINUTE=30

# ── General chat API (/v1) ───────────────────────────────────────────────────
# Models callers may request, comma-separated. Blank = DEFAULT_MODEL (and any
# MODEL_OVERRIDES models). Each must be pulled; on a 24 GB server keep it to
# one or two, or requests will swap models in and out of memory.
CHAT_MODELS=
# Rounds of server-side tool calls (skills, plugins) per request, and the time
# limit for each plugin call.
MAX_TOOL_STEPS=8
TOOL_TIMEOUT_SECONDS=30

# ── Other ────────────────────────────────────────────────────────────────────
# Interactive API docs at https://DOMAIN/docs (schemas only, no data).
DOCS_ENABLED=true
# Pin a release once things work, so updates are deliberate.
OLLAMA_VERSION=latest
OLLAMA_KEEP_ALIVE=24h
OLLAMA_FLASH_ATTENTION=1
