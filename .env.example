# Copy to .env — scripts/setup.sh does this and generates the password.

# Hostname pointing at this server (an A record to the VPS IP), e.g.
# ai.example.com. Caddy gets the HTTPS certificate for it automatically.
# :80 serves plain HTTP for a first test without a domain — not for real use.
DOMAIN=ai.example.com

# Database password, generated by setup.sh. Back up .env: without it the
# database backups cannot be restored into a new server easily.
POSTGRES_PASSWORD=

# Password for the admin console at https://DOMAIN/admin (keys, usage,
# models, playground). Generated by setup.sh. Blank = console switched off.
ADMIN_TOKEN=

# ── Models ───────────────────────────────────────────────────────────────────
# Downloaded by scripts/pull-models.sh. Check the license of each before using
# it in a paid product, and record it in MODELS.md.
# Several families, so each kind of task can use the model that suits it.
# Sizes on disk ≈ 5, 2.5, 4.4, 4.9, 3.3, 5.2, 1.2 GB. setup.sh picks a set
# sized to the server; see MODELS.md for licenses and what each is good at.
MODELS="qwen3:8b qwen3:4b mistral:7b llama3.1:8b gemma3:4b deepseek-r1:8b bge-m3"
# Used when a request names no model (or asks for "default").
DEFAULT_MODEL=qwen3:8b

# ── Capacity (defaults fit an 8 vCPU / 24 GB CPU server) ─────────────────────
# Memory the model runtime may use. Leave 6-8 GB for the OS, Postgres and API.
OLLAMA_MEMORY_LIMIT=16g
# Default context window (tokens) when a request doesn't set one. Longer
# conversations and big tool sets need more — Claude Code ~32768 — and it costs RAM.
NUM_CTX=12288
# Model calls at once. 1 on CPU; raise on a GPU with memory to spare.
OLLAMA_NUM_PARALLEL=1
# Models kept in memory at once. Others load on demand (10-60 s on a CPU)
# and push out the least recently used. 2 fits two ~5 GB models in 16 GB.
OLLAMA_MAX_LOADED_MODELS=2
# How long a request waits for its turn before a 503 + Retry-After.
QUEUE_TIMEOUT_SECONDS=120
DEFAULT_RATE_LIMIT_PER_MINUTE=30

# ── What callers may use ─────────────────────────────────────────────────────
# Chat models callers may request, comma-separated (each must be in MODELS).
# Blank = DEFAULT_MODEL only.
CHAT_MODELS=qwen3:8b,qwen3:4b,mistral:7b,llama3.1:8b,gemma3:4b,deepseek-r1:8b
# Embedding models (for search / similarity), comma-separated. Blank = none.
EMBEDDING_MODELS=bge-m3
# Role names: apps ask for a role ("fast", "vision"…), you decide which model
# fills it — and can switch later, after benchmarking, without touching apps.
# claude-* lets Claude Code work unchanged (it asks for claude-… models).
MODEL_ALIASES=general=qwen3:8b,fast=qwen3:4b,reasoning=deepseek-r1:8b,vision=gemma3:4b,embed=bge-m3,claude-*=qwen3:8b
# model = each model's own default (Qwen3 thinks before answering).
# off = no thinking phase unless a request asks for one: about twice as fast
# on a CPU, but small models then call tools much less reliably and make more
# factual mistakes. Keep "model" if customers use tools (Claude Code, agents).
THINKING=model

# ── Other ────────────────────────────────────────────────────────────────────
# Interactive API docs at https://DOMAIN/docs (schemas only, no data).
DOCS_ENABLED=true
# Pin a release once things work, so updates are deliberate.
OLLAMA_VERSION=latest
OLLAMA_KEEP_ALIVE=24h
OLLAMA_FLASH_ATTENTION=1
